      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-037",
      "domain_id": "agreeableness",
      "text": "我很少关心别人。",
      "source_text_en": "Feel little concern for others.",
      "key": "reverse",
      "source_section_index": 17,
      "source_section_label": "Agreeableness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-038",
      "domain_id": "agreeableness",
      "text": "我并不真正对他人感兴趣。",
      "source_text_en": "Am not really interested in others.",
      "key": "reverse",
      "source_section_index": 18,
      "source_section_label": "Agreeableness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-039",
      "domain_id": "agreeableness",
      "text": "别人很难深入了解我。",
      "source_text_en": "Am hard to get to know.",
      "key": "reverse",
      "source_section_index": 19,
      "source_section_label": "Agreeableness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-040",
      "domain_id": "agreeableness",
      "text": "我对别人的感受漠不关心。",
      "source_text_en": "Am indifferent to the feelings of others.",
      "key": "reverse",
      "source_section_index": 20,
      "source_section_label": "Agreeableness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-041",
      "domain_id": "conscientiousness",
      "text": "我总是做好准备。",
      "source_text_en": "Am always prepared.",
      "key": "positive",
      "source_section_index": 1,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-042",
      "domain_id": "conscientiousness",
      "text": "我会注意细节。",
      "source_text_en": "Pay attention to details.",
      "key": "positive",
      "source_section_index": 2,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-043",
      "domain_id": "conscientiousness",
      "text": "我会马上完成日常杂务。",
      "source_text_en": "Get chores done right away.",
      "key": "positive",
      "source_section_index": 3,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-044",
      "domain_id": "conscientiousness",
      "text": "我喜欢井然有序。",
      "source_text_en": "Like order.",
      "key": "positive",
      "source_section_index": 4,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-045",
      "domain_id": "conscientiousness",
      "text": "我会遵循时间安排。",
      "source_text_en": "Follow a schedule.",
      "key": "positive",
      "source_section_index": 5,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-046",
      "domain_id": "conscientiousness",
      "text": "我对自己的工作要求严格。",
      "source_text_en": "Am exacting in my work.",
      "key": "positive",
      "source_section_index": 6,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-047",
      "domain_id": "conscientiousness",
      "text": "我会按计划做事。",
      "source_text_en": "Do things according to a plan.",
      "key": "positive",
      "source_section_index": 7,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-048",
      "domain_id": "conscientiousness",
      "text": "我会持续努力，直到一切都很完美。",
      "source_text_en": "Continue until everything is perfect.",
      "key": "positive",
      "source_section_index": 8,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-049",
      "domain_id": "conscientiousness",
      "text": "我会制定计划并坚持执行。",
      "source_text_en": "Make plans and stick to them.",
      "key": "positive",
      "source_section_index": 9,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-050",
      "domain_id": "conscientiousness",
      "text": "我喜欢秩序和规律。",
      "source_text_en": "Love order and regularity.",
      "key": "positive",
      "source_section_index": 10,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-051",
      "domain_id": "conscientiousness",
      "text": "我喜欢整理东西。",
      "source_text_en": "Like to tidy up.",
      "key": "positive",
      "source_section_index": 11,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-052",
      "domain_id": "conscientiousness",
      "text": "我会随手乱放自己的物品。",
      "source_text_en": "Leave my belongings around.",
      "key": "reverse",
      "source_section_index": 12,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-053",
      "domain_id": "conscientiousness",
      "text": "我会把事情弄得一团糟。",
      "source_text_en": "Make a mess of things.",
      "key": "reverse",
      "source_section_index": 13,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-054",
      "domain_id": "conscientiousness",
      "text": "我常忘记把东西放回原来的位置。",
      "source_text_en": "Often forget to put things back in their proper place.",
      "key": "reverse",
      "source_section_index": 14,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-055",
      "domain_id": "conscientiousness",
      "text": "我会逃避自己的职责。",
      "source_text_en": "Shirk my duties.",
      "key": "reverse",
      "source_section_index": 15,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-056",
      "domain_id": "conscientiousness",
      "text": "我会疏忽自己应尽的职责。",
      "source_text_en": "Neglect my duties.",
      "key": "reverse",
      "source_section_index": 16,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-057",
      "domain_id": "conscientiousness",
      "text": "我会浪费自己的时间。",
      "source_text_en": "Waste my time.",
      "key": "reverse",
      "source_section_index": 17,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-058",
      "domain_id": "conscientiousness",
      "text": "我做事常常半途而废。",
      "source_text_en": "Do things in a half-way manner.",
      "key": "reverse",
      "source_section_index": 18,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-059",
      "domain_id": "conscientiousness",
      "text": "我觉得很难开始投入工作。",
      "source_text_en": "Find it difficult to get down to work.",
      "key": "reverse",
      "source_section_index": 19,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-060",
      "domain_id": "conscientiousness",
      "text": "我会让自己的房间保持凌乱。",
      "source_text_en": "Leave a mess in my room.",
      "key": "reverse",
      "source_section_index": 20,
      "source_section_label": "Conscientiousness / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-061",
      "domain_id": "emotional-stability",
      "text": "大多数时候，我感到放松。",
      "source_text_en": "Am relaxed most of the time.",
      "key": "positive",
      "source_section_index": 1,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-062",
      "domain_id": "emotional-stability",
      "text": "我很少感到情绪低落。",
      "source_text_en": "Seldom feel blue.",
      "key": "positive",
      "source_section_index": 2,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-063",
      "domain_id": "emotional-stability",
      "text": "我不容易被事情困扰。",
      "source_text_en": "Am not easily bothered by things.",
      "key": "positive",
      "source_section_index": 3,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-064",
      "domain_id": "emotional-stability",
      "text": "我很少感到烦躁。",
      "source_text_en": "Rarely get irritated.",
      "key": "positive",
      "source_section_index": 4,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-065",
      "domain_id": "emotional-stability",
      "text": "我很少发火。",
      "source_text_en": "Seldom get mad.",
      "key": "positive",
      "source_section_index": 5,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-066",
      "domain_id": "emotional-stability",
      "text": "我容易感到压力很大。",
      "source_text_en": "Get stressed out easily.",
      "key": "reverse",
      "source_section_index": 6,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-067",
      "domain_id": "emotional-stability",
      "text": "我会为各种事情担忧。",
      "source_text_en": "Worry about things.",
      "key": "reverse",
      "source_section_index": 7,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-068",
      "domain_id": "emotional-stability",
      "text": "我容易受到困扰。",
      "source_text_en": "Am easily disturbed.",
      "key": "reverse",
      "source_section_index": 8,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-069",
      "domain_id": "emotional-stability",
      "text": "我容易心烦意乱。",
      "source_text_en": "Get upset easily.",
      "key": "reverse",
      "source_section_index": 9,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-070",
      "domain_id": "emotional-stability",
      "text": "我的心情变化很多。",
      "source_text_en": "Change my mood a lot.",
      "key": "reverse",
      "source_section_index": 10,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-071",
      "domain_id": "emotional-stability",
      "text": "我的情绪经常起伏不定。",
      "source_text_en": "Have frequent mood swings.",
      "key": "reverse",
      "source_section_index": 11,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-072",
      "domain_id": "emotional-stability",
      "text": "我容易感到烦躁。",
      "source_text_en": "Get irritated easily.",
      "key": "reverse",
      "source_section_index": 12,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-073",
      "domain_id": "emotional-stability",
      "text": "我经常感到情绪低落。",
      "source_text_en": "Often feel blue.",
      "key": "reverse",
      "source_section_index": 13,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-074",
      "domain_id": "emotional-stability",
      "text": "我容易生气。",
      "source_text_en": "Get angry easily.",
      "key": "reverse",
      "source_section_index": 14,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-075",
      "domain_id": "emotional-stability",
      "text": "我容易惊慌。",
      "source_text_en": "Panic easily.",
      "key": "reverse",
      "source_section_index": 15,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-076",
      "domain_id": "emotional-stability",
      "text": "我容易感到受到威胁。",
      "source_text_en": "Feel threatened easily.",
      "key": "reverse",
      "source_section_index": 16,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-077",
      "domain_id": "emotional-stability",
      "text": "我容易被情绪淹没。",
      "source_text_en": "Get overwhelmed by emotions.",
      "key": "reverse",
      "source_section_index": 17,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-078",
      "domain_id": "emotional-stability",
      "text": "我容易觉得被冒犯。",
      "source_text_en": "Take offense easily.",
      "key": "reverse",
      "source_section_index": 18,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-079",
      "domain_id": "emotional-stability",
      "text": "我容易陷在自己的烦恼之中。",
      "source_text_en": "Get caught up in my problems.",
      "key": "reverse",
      "source_section_index": 19,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-080",
      "domain_id": "emotional-stability",
      "text": "我会对各种事情发牢骚。",
      "source_text_en": "Grumble about things.",
      "key": "reverse",
      "source_section_index": 20,
      "source_section_label": "Emotional Stability / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-081",
      "domain_id": "intellect-imagination",
      "text": "我的词汇量丰富。",
      "source_text_en": "Have a rich vocabulary.",
      "key": "positive",
      "source_section_index": 1,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-082",
      "domain_id": "intellect-imagination",
      "text": "我的想象力生动丰富。",
      "source_text_en": "Have a vivid imagination.",
      "key": "positive",
      "source_section_index": 2,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-083",
      "domain_id": "intellect-imagination",
      "text": "我能提出很好的想法。",
      "source_text_en": "Have excellent ideas.",
      "key": "positive",
      "source_section_index": 3,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-084",
      "domain_id": "intellect-imagination",
      "text": "我能迅速理解事物。",
      "source_text_en": "Am quick to understand things.",
      "key": "positive",
      "source_section_index": 4,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-085",
      "domain_id": "intellect-imagination",
      "text": "我会使用较难懂的词语。",
      "source_text_en": "Use difficult words.",
      "key": "positive",
      "source_section_index": 5,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-086",
      "domain_id": "intellect-imagination",
      "text": "我会花时间思考事情。",
      "source_text_en": "Spend time reflecting on things.",
      "key": "positive",
      "source_section_index": 6,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-087",
      "domain_id": "intellect-imagination",
      "text": "我脑子里有很多想法。",
      "source_text_en": "Am full of ideas.",
      "key": "positive",
      "source_section_index": 7,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-088",
      "domain_id": "intellect-imagination",
      "text": "我能让谈话进入更深入的层次。",
      "source_text_en": "Carry the conversation to a higher level.",
      "key": "positive",
      "source_section_index": 8,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-089",
      "domain_id": "intellect-imagination",
      "text": "我能很快领会事情的意思。",
      "source_text_en": "Catch on to things quickly.",
      "key": "positive",
      "source_section_index": 9,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-090",
      "domain_id": "intellect-imagination",
      "text": "我能处理大量信息。",
      "source_text_en": "Can handle a lot of information.",
      "key": "positive",
      "source_section_index": 10,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-091",
      "domain_id": "intellect-imagination",
      "text": "我喜欢想出做事的新方法。",
      "source_text_en": "Love to think up new ways of doing things.",
      "key": "positive",
      "source_section_index": 11,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-092",
      "domain_id": "intellect-imagination",
      "text": "我喜欢阅读有挑战性的材料。",
      "source_text_en": "Love to read challenging material.",
      "key": "positive",
      "source_section_index": 12,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-093",
      "domain_id": "intellect-imagination",
      "text": "我擅长许多事情。",
      "source_text_en": "Am good at many things.",
      "key": "positive",
      "source_section_index": 13,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-094",
      "domain_id": "intellect-imagination",
      "text": "我觉得抽象概念很难理解。",
      "source_text_en": "Have difficulty understanding abstract ideas.",
      "key": "reverse",
      "source_section_index": 14,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-095",
      "domain_id": "intellect-imagination",
      "text": "我对抽象概念不感兴趣。",
      "source_text_en": "Am not interested in abstract ideas.",
      "key": "reverse",
      "source_section_index": 15,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-096",
      "domain_id": "intellect-imagination",
      "text": "我的想象力不太好。",
      "source_text_en": "Do not have a good imagination.",
      "key": "reverse",
      "source_section_index": 16,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-097",
      "domain_id": "intellect-imagination",
      "text": "我会尽量避开性格复杂的人。",
      "source_text_en": "Try to avoid complex people.",
      "key": "reverse",
      "source_section_index": 17,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-098",
      "domain_id": "intellect-imagination",
      "text": "我觉得在脑海中想象事物很困难。",
      "source_text_en": "Have difficulty imagining things.",
      "key": "reverse",
      "source_section_index": 18,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-099",
      "domain_id": "intellect-imagination",
      "text": "我会避开难读的材料。",
      "source_text_en": "Avoid difficult reading material.",
      "key": "reverse",
      "source_section_index": 19,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    },
    {
      "id": "IPIP100-100",
      "domain_id": "intellect-imagination",
      "text": "我不会深入探究一个话题。",
      "source_text_en": "Will not probe deeply into a subject.",
      "key": "reverse",
      "source_section_index": 20,
      "source_section_label": "Intellect / Imagination / 20-item scale",
      "source_url": "https://ipip.ori.org/newBigFive5broadKey.htm",
      "required": false
    }
  ],
