{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "College daily self-reflection question bank",
  "type": "object",
  "required": [
    "schema_version",
    "bank_id",
    "version",
    "title",
    "language",
    "status",
    "item_count",
    "theme_count",
    "instructions",
    "purpose",
    "intended_audience",
    "recall_period",
    "administration",
    "response_options",
    "skip_options",
    "interpretation",
    "privacy",
    "support_text",
    "provenance",
    "sources",
    "themes",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "bank_id": {
      "const": "college-daily-self-reflection-zh-cn"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "zh-CN"
    },
    "status": {
      "const": "original_draft_unvalidated"
    },
    "item_count": {
      "const": 500
    },
    "theme_count": {
      "const": 20
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "intended_audience": {
      "type": "string",
      "minLength": 1
    },
    "support_text": {
      "type": "string",
      "minLength": 1
    },
    "recall_period": {
      "type": "object",
      "required": [
        "days",
        "label"
      ],
      "properties": {
        "days": {
          "const": 14
        },
        "label": {
          "const": "过去两周"
        }
      }
    },
    "response_options": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label",
          "order"
        ],
        "properties": {
          "code": {
            "enum": [
              "never",
              "rarely",
              "sometimes",
              "often",
              "almost_always"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "additionalProperties": false
      }
    },
    "skip_options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "enum": [
              "not_applicable",
              "prefer_not_to_answer"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "administration": {
      "type": "object",
      "required": [
        "default_form",
        "items_per_theme",
        "allow_skip",
        "allow_exit",
        "require_all_500",
        "random_selection_is_validated"
      ],
      "properties": {
        "default_form": {
          "const": "one_theme"
        },
        "items_per_theme": {
          "const": 25
        },
        "allow_skip": {
          "const": true
        },
        "allow_exit": {
          "const": true
        },
        "require_all_500": {
          "const": false
        },
        "random_selection_is_validated": {
          "const": false
        }
      }
    },
    "interpretation": {
      "type": "object",
      "required": [
        "method",
        "generate_total_score",
        "diagnostic_thresholds",
        "norms",
        "reverse_scoring",
        "indicator_meaning",
        "guidance"
      ],
      "properties": {
        "method": {
          "const": "response_distribution_only"
        },
        "generate_total_score": {
          "const": false
        },
        "diagnostic_thresholds": {
          "type": "null"
        },
        "norms": {
          "type": "null"
        },
        "reverse_scoring": {
          "const": false
        },
        "indicator_meaning": {
          "type": "object"
        },
        "guidance": {
          "type": "string"
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "collection",
        "sharing",
        "automation",
        "implementation_status"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "description",
        "reference_ids",
        "item_level_translation_mapping"
      ],
      "properties": {
        "id": {
          "const": "original-campus-20261015"
        },
        "kind": {
          "const": "original_ai_assisted"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "reference_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "item_level_translation_mapping": {
          "type": "null"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "accessed_on",
          "role",
          "reuse_notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "accessed_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "published_on": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "reuse_notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "themes": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "item_count",
          "question_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+(?:-[a-z]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "item_count": {
            "const": 25
          },
          "question_ids": {
            "type": "array",
            "minItems": 25,
            "maxItems": 25,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CDSR-[0-9]{4}$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "minItems": 500,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "theme_id",
          "order_in_theme",
          "text",
          "indicator",
          "response_type",
          "required",
          "provenance_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CDSR-[0-9]{4}$"
          },
          "theme_id": {
            "type": "string"
          },
          "order_in_theme": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "text": {
            "type": "string",
            "minLength": 8,
            "maxLength": 80
          },
          "indicator": {
            "enum": [
              "resource",
              "challenge"
            ]
          },
          "response_type": {
            "const": "single_choice_frequency"
          },
          "required": {
            "const": false
          },
          "provenance_id": {
            "const": "original-campus-20261015"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
