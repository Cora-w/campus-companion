{
  "openapi": "3.0.3",
  "info": {
    "title": "心伙伴认证接口协作草案",
    "version": "0.2.0",
    "description": "学校与学号联合登录；公开昵称头像与教师受限身份资料分离。业务接口为待后端实现的契约。"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "以学校和学号/校园账号登录，身份与学校由服务端确认",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "401": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "403": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "429": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "500": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "使当前会话失效",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "成功，无响应体"
          },
          "401": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "500": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          }
        }
      }
    },
    "/schools": {
      "get": {
        "operationId": "listSchools",
        "summary": "查询当前开放绑定的学校",
        "security": [],
        "responses": {
          "200": {
            "description": "学校列表，目前只开放四川航天职业技术学院",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/School"
                  }
                }
              }
            }
          },
          "401": {
            "description": "登录已过期"
          }
        },
        "description": "未登录时可查询开放学校，供登录前搜索选择。"
      }
    },
    "/users/me/school": {
      "get": {
        "operationId": "getMySchool",
        "summary": "查询登录用户的学校，未绑定返回 JSON null",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "已绑定学校或 null",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "city"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "city": {
                      "type": "string"
                    }
                  },
                  "nullable": true
                }
              }
            }
          },
          "401": {
            "description": "登录已过期"
          }
        },
        "description": "读取认证会话的学校；学校在登录前选择并由认证确认，不在登录后绑定或自行更换。"
      }
    },
    "/users/{id}/profile": {
      "get": {
        "summary": "公开资料只返回昵称和头像",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "同校公开资料；不得含真实姓名、学号、手机号、学院或班级",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicProfile"
                }
              }
            }
          },
          "403": {
            "description": "无权访问或不同学校"
          }
        }
      }
    },
    "/teacher/students/{id}/identity": {
      "get": {
        "summary": "仅同校负责该学生的有效教师可读取真实身份",
        "description": "服务器从令牌确定教师身份并校验学校、负责关系及学生状态；管理员、学生及未授权教师均拒绝。留痕只含对象ID和动作，不记录姓名或学号。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "授权学生身份",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentIdentity"
                }
              }
            }
          },
          "403": {
            "description": "不属于有效的同校负责教师"
          }
        }
      }
    },
    "/users/me/profile": {
      "get": {
        "summary": "仅读取当前用户本人的公开和私密资料",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "本人资料，不能缓存为他人的公开资料",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnProfile"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "本人修改昵称头像和填写资料，不改变学号、学校、角色或用户ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "nickname": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16
                  },
                  "avatar": {
                    "type": "string"
                  },
                  "realName": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "college": {
                    "type": "string"
                  },
                  "major": {
                    "type": "string"
                  },
                  "grade": {
                    "type": "string"
                  },
                  "className": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已保存本人资料"
          },
          "403": {
            "description": "禁止修改学号、学校或角色"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "注册学生账号，服务端校验学校政策与账号唯一性；不允许指定身份",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "学生注册成功并登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "403": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "409": {
            "description": "该学校下的账号已存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "429": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "500": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register/code": {
      "post": {
        "operationId": "requestRegistrationCode",
        "summary": "申请学生注册手机验证码，由服务端调用短信服务发送",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "验证码发送请求成功；不返回验证码正文",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationCodeResponse"
                }
              }
            }
          },
          "400": {
            "description": "手机号或学校不正确",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          },
          "503": {
            "description": "短信发送暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiFailure"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "schoolId",
          "account",
          "password"
        ],
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "学校内唯一的学号/校园账号，不是全局用户ID"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 128
          },
          "schoolId": {
            "type": "string",
            "minLength": 1,
            "description": "先从公开学校列表选择；凭据必须匹配此学校"
          }
        },
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "required": [
          "id",
          "nickname",
          "role",
          "schoolId"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "全局唯一的不透明用户ID，与学号不同"
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "description": "公开昵称，不能以真实姓名作为回退值"
          },
          "avatar": {
            "type": "string"
          },
          "schoolId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "teacher",
              "admin"
            ]
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "user",
          "accessToken"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/Session"
          },
          "accessToken": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ApiFailure": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "School": {
        "type": "object",
        "required": [
          "id",
          "name",
          "city"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "type": "string"
          }
        }
      },
      "PublicProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nickname",
          "avatar"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "不透明用户ID"
          },
          "nickname": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          }
        }
      },
      "StudentIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "studentId",
          "realName",
          "studentNumber"
        ],
        "properties": {
          "studentId": {
            "type": "string",
            "description": "不透明用户ID"
          },
          "realName": {
            "type": "string"
          },
          "studentNumber": {
            "type": "string",
            "description": "认证学号，不可由修改公开资料覆盖"
          }
        }
      },
      "OwnProfile": {
        "type": "object",
        "required": [
          "nickname",
          "avatar",
          "realName",
          "studentNumber"
        ],
        "properties": {
          "nickname": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "realName": {
            "type": "string"
          },
          "studentNumber": {
            "type": "string",
            "readOnly": true,
            "description": "与认证登录学号一致，不允许客户端更改"
          },
          "college": {
            "type": "string"
          },
          "major": {
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "className": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schoolId",
          "account",
          "nickname",
          "password",
          "phone",
          "verificationId",
          "verificationCode"
        ],
        "properties": {
          "schoolId": {
            "type": "string",
            "minLength": 1
          },
          "account": {
            "type": "string",
            "minLength": 4,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9_\\-.]{4,32}$"
          },
          "nickname": {
            "type": "string",
            "minLength": 2,
            "maxLength": 20
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 8,
            "maxLength": 64,
            "description": "包含字母与数字；服务端执行独立验证。"
          },
          "phone": {
            "type": "string",
            "pattern": "^1[3-9][0-9]{9}$",
            "description": "中国大陆手机号"
          },
          "verificationId": {
            "type": "string",
            "minLength": 1,
            "description": "获取验证码接口返回的请求标识"
          },
          "verificationCode": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "writeOnly": true
          }
        }
      },
      "RegisterResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/LoginResponse"
          },
          {
            "type": "object",
            "properties": {
              "user": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "student"
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "RegistrationCodeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schoolId",
          "phone"
        ],
        "properties": {
          "schoolId": {
            "type": "string",
            "minLength": 1
          },
          "phone": {
            "type": "string",
            "pattern": "^1[3-9][0-9]{9}$",
            "description": "中国大陆手机号"
          }
        }
      },
      "RegistrationCodeResponse": {
        "type": "object",
        "required": [
          "verificationId",
          "expiresIn",
          "resendAfter"
        ],
        "properties": {
          "verificationId": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 1,
            "description": "有效期秒数"
          },
          "resendAfter": {
            "type": "integer",
            "minimum": 1,
            "description": "重发冷却秒数"
          }
        }
      }
    }
  }
}
